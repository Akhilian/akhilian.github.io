---
import Template from "./template.astro";

const { frontmatter } = Astro.props;

import dayjs from 'dayjs';
import 'dayjs/locale/fr';
import ArticleCheck from "../components/ArticleCheck.astro";
import Tag from "../components/Tag.astro";
dayjs.locale('fr')

const publicationDate = dayjs(frontmatter.pubDate).format('D MMM YYYY');
---
<style>
.time {
    color: var(--color-ink-muted);
    font-size: 0.9em;
    margin: 0 0 0.5rem;
}

.tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
}

.reader-bar {
    display: none;
}

/*
 * Lecture « pleine page » : le texte remplit des colonnes de toute la hauteur
 * de l'écran et la lecture avance vers la droite, comme on tourne les pages
 * d'un journal. Réservée aux écrans assez larges et assez hauts ; ailleurs,
 * l'article se lit en une colonne verticale classique.
 */
@media screen and (min-width: 900px) and (min-height: 600px) {
    .reader {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .articles {
        flex: 1;
        min-height: 0;

        column-width: 22rem;
        column-gap: var(--reader-column-gap);
        column-rule: 1px solid var(--color-column-rule);
        column-fill: auto;

        overflow-x: auto;
        overflow-y: hidden;
        padding: 1rem var(--reader-gutter) 2rem;

        scrollbar-width: thin;
        scrollbar-color: var(--color-column-rule) transparent;
    }

    .articles:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: -2px;
    }

    .article-head {
        break-inside: avoid;
        margin-bottom: 1.5rem;
    }

    .article-head h1 {
        margin: 0.75rem 0 0;
        line-height: 1.12;
    }

    .articles :global(h2),
    .articles :global(h3) {
        break-after: avoid;
        margin: 2.25rem 0 1rem;
    }

    /* Un paragraphe entièrement en gras sert de mini-titre : il reste avec la suite. */
    .articles :global(p:has(> strong:only-child)) {
        break-after: avoid;
    }

    .articles :global(p),
    .articles :global(li) {
        text-align: justify;
        hyphens: auto;
    }

    .articles :global(p),
    .articles :global(li) {
        font-size: 1.0625rem;
        line-height: 1.6;
    }

    .articles :global(p) {
        margin: 0 0 1.25em;
    }

    .articles :global(li) {
        margin-bottom: 0.4em;
    }

    .articles :global(blockquote) {
        margin: 1.75rem 0;
    }

    .articles :global(:is(blockquote, li, pre, figure, img, table)) {
        break-inside: avoid;
    }

    .articles :global(img) {
        max-width: 100%;
        max-height: 100%;
    }

    /* La barre n'apparaît que si le script est là pour la faire fonctionner. */
    .reader-bar.is-ready {
        display: flex;
        align-items: center;
        gap: 1rem;

        padding: 0.75rem var(--reader-gutter);
        border-top: 1px solid var(--color-column-rule);
    }

    .reader-hint {
        margin: 0;
        font-size: 0.875rem;
        color: var(--color-ink-muted);
        white-space: nowrap;
    }

    .reader-hint kbd {
        font-family: var(--font-body);
        font-size: 0.8rem;
        padding: 0 0.3em;
        border: 1px solid var(--color-column-rule);
        border-radius: 0.25rem;
        color: var(--color-ink-muted);
    }

    .reader-progress {
        flex: 1;
        height: 2px;
        background: var(--color-column-rule);
        overflow: hidden;
    }

    .reader-progress-fill {
        height: 100%;
        background: var(--color-ink);
        transform-origin: left;
        transform: scaleX(0);
        transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .reader-status {
        margin: 0;
        font-size: 0.875rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .reader-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;

        background: transparent;
        border: 1px solid var(--color-column-rule);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background-color 120ms ease-out, transform 120ms ease-out;
    }

    .reader-button svg {
        stroke: var(--color-ink);
    }

    .reader-button:hover:not(:disabled) {
        background: var(--color-tag);
    }

    .reader-button:active:not(:disabled) {
        transform: scale(0.94);
    }

    .reader-button:focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 2px;
    }

    .reader-button:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }
}

@media (prefers-reduced-motion: reduce) {
    .reader-progress-fill,
    .reader-button {
        transition: none;
    }

    .reader-button:active:not(:disabled) {
        transform: none;
    }
}
</style>

<Template title={frontmatter.title} description={frontmatter.description} type="article" pubDate={frontmatter.pubDate} tags={frontmatter.tags} noindex={!frontmatter.published} bodyClass="reader-page">
    <article class="reader">
        <div class="articles" data-reader tabindex="0" aria-label="Texte de l’article, lecture horizontale">
            <ArticleCheck post={frontmatter} />
            <header class="article-head">
                <p class="time"><time datetime={dayjs(frontmatter.pubDate).format('YYYY-MM-DD')}>{publicationDate}</time></p>
                <div class="tags">{frontmatter.tags.map((tag) => (<Tag>{tag}</Tag>))}</div>
                <h1>{frontmatter.title}</h1>
            </header>
            <slot/>
        </div>

        <nav class="reader-bar" data-reader-bar aria-label="Navigation dans l’article">
            <p class="reader-hint">Lecture horizontale : molette, <kbd>←</kbd> <kbd>→</kbd> ou glisser</p>
            <div class="reader-progress" aria-hidden="true"><div class="reader-progress-fill" data-reader-fill></div></div>
            <p class="reader-status" data-reader-status aria-live="polite">Page 1 sur 1</p>
            <button class="reader-button" type="button" data-reader-prev aria-label="Page précédente">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button class="reader-button" type="button" data-reader-next aria-label="Page suivante">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
        </nav>
    </article>
</Template>

<script>
    const reader = document.querySelector<HTMLElement>('[data-reader]');
    const bar = document.querySelector<HTMLElement>('[data-reader-bar]');

    if (reader && bar) {
        const wide = window.matchMedia('(min-width: 900px) and (min-height: 600px)');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
        const prev = bar.querySelector<HTMLButtonElement>('[data-reader-prev]')!;
        const next = bar.querySelector<HTMLButtonElement>('[data-reader-next]')!;
        const status = bar.querySelector<HTMLElement>('[data-reader-status]')!;
        const fill = bar.querySelector<HTMLElement>('[data-reader-fill]')!;

        // Largeur d'une « page » : toutes les colonnes visibles, gouttière comprise.
        const pageWidth = () => {
            const style = getComputedStyle(reader);
            const gap = parseFloat(style.columnGap) || 0;
            return reader.clientWidth - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight) + gap;
        };

        const update = () => {
            const page = pageWidth();
            const max = reader.scrollWidth - reader.clientWidth;
            const total = max > 2 ? Math.ceil((max - 2) / page) + 1 : 1;
            const atEnd = reader.scrollLeft >= max - 2;
            const current = atEnd ? total : Math.min(total, Math.round(reader.scrollLeft / page) + 1);

            status.textContent = `Page ${current} sur ${total}`;
            prev.disabled = reader.scrollLeft <= 2;
            next.disabled = atEnd;
            fill.style.transform = `scaleX(${max > 0 ? reader.scrollLeft / max : 1})`;
        };

        const turn = (direction: number) => {
            reader.scrollBy({ left: direction * pageWidth(), behavior: reduce.matches ? 'auto' : 'smooth' });
        };

        const setup = () => {
            bar.classList.toggle('is-ready', wide.matches);
            update();
        };

        prev.addEventListener('click', () => turn(-1));
        next.addEventListener('click', () => turn(1));
        reader.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        wide.addEventListener('change', setup);

        // La molette verticale fait avancer le texte vers la droite.
        window.addEventListener('wheel', (event) => {
            if (!wide.matches || Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
            event.preventDefault();
            reader.scrollBy({ left: event.deltaY });
        }, { passive: false });

        document.addEventListener('keydown', (event) => {
            if (!wide.matches || event.altKey || event.ctrlKey || event.metaKey) return;
            const target = event.target as HTMLElement;
            if (target.closest('input, textarea, select, [contenteditable]')) return;

            const keys: Record<string, number> = {
                ArrowRight: 1, PageDown: 1, ArrowLeft: -1, PageUp: -1,
            };
            if (event.key === ' ') keys[' '] = event.shiftKey ? -1 : 1;
            if (target.closest('button') && event.key === ' ') return;

            if (event.key in keys) {
                event.preventDefault();
                turn(keys[event.key]);
            } else if (event.key === 'Home' || event.key === 'End') {
                event.preventDefault();
                reader.scrollTo({ left: event.key === 'Home' ? 0 : reader.scrollWidth, behavior: reduce.matches ? 'auto' : 'smooth' });
            }
        });

        setup();
    }
</script>
