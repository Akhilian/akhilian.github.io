---
import { Image } from 'astro:assets';
import portrait from '../assets/adrien_saunier.webp';
// Sur l'accueil, la salutation passe dans la une du journal.
const { greeting = true } = Astro.props;
---
<style>
    header {
        box-sizing: border-box;
        width: 100%;
        max-width: 1024px;
        margin: 0 auto;
        padding: 2rem 2rem 0;
    }

    p {
        text-align: center;
        font-family: var(--font-display);
        font-size: 1.8rem;
        margin: 0;
        line-height: 1.2;
        text-wrap: balance;
    }

    .contact {
        padding-bottom: 2rem;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        img {
            display: block;
            width: 8rem;
            height: 8rem;
            border-radius: 50%;
        }

        @media only screen and (min-width: 600px) {
            flex-direction: row;

            img {
                width: 3rem;
                height: 3rem;
            }
        }

        align-items: center;
        gap: 1rem;

        .networks {
            display: flex;
            gap: 1rem;
        }

        .networks a {
            display: inline-flex;
            padding: 0.25rem;
            margin: -0.25rem;
        }

        svg {
            stroke: var(--color-icon);
            transition: stroke 160ms ease-out, transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* Micro-animation : l'icône se soulève en basculant un peu et prend l'orange de la photo. */
        .networks a:hover svg,
        .networks a:focus-visible svg {
            stroke: var(--color-accent);
            transform: translateY(-2px) rotate(-8deg) scale(1.08);
        }

        .networks a:active svg {
            transform: scale(0.92);
            transition-duration: 80ms;
        }

        @media (prefers-reduced-motion: reduce) {
            svg {
                transition: stroke 160ms ease-out;
            }

            .networks a:hover svg,
            .networks a:focus-visible svg,
            .networks a:active svg {
                transform: none;
            }
        }
    }
</style>
<header>
    <div class="contact">
        <a href="/"><Image src={portrait} alt="Carnet d’Adrien, retour à l’accueil" widths={[96, 210]} sizes="(min-width: 600px) 48px, 128px" loading="eager" fetchpriority="high"/></a>
        <nav class="networks" aria-label="Réseaux">
            <a href="https://www.linkedin.com/in/saunier-adrien" rel="me external" title="LinkedIn" aria-label="LinkedIn">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-linkedin">
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                    <rect width="4" height="12" x="2" y="9"/>
                    <circle cx="4" cy="4" r="2"/>
                </svg>
            </a>
            <a href="https://github.com/Akhilian/" rel="me external" title="GitHub" aria-label="GitHub">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-github">
                    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/>
                    <path d="M9 18c-4.51 2-5-2-7-2"/>
                </svg>
            </a>
            <a href="/rss.xml" type="application/rss+xml" title="Flux RSS" aria-label="Flux RSS">
                <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
            </a>
        </nav>
    </div>

    {greeting && <p style="margin-bottom: 1rem;">Hello 👋. Moi, c’est Adrien.</p>}
</header>


